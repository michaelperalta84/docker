Vagrant.configure("2") do |config|
  servers = [
    {
      :hostname => "Server1",
      :box => "bento/ubuntu-18.04",
      :ip => "172.16.1.50",
      :ssh_port => '2200'
    },
    {
      :hostname => "Server2",
      :box => "bento/ubuntu-18.04",
      :ip => "172.16.1.51",
      :ssh_port => '2201'
    },
    {
      :hostname => "Server3",
      :box => "bento/ubuntu-18.04",
      :ip => "192.168.56.102",
      :ssh_port => '2202'
    }
  ]

  servers.each do |machine|
    config.vm.define machine[:hostname] do |node|
      node.vm.box = machine[:box]
      node.vm.hostname = machine[:hostname]
      node.vm.network :private_network, ip: machine[:ip]
      node.vm.network "forwarded_port", guest: 22, host: machine[:ssh_port], id: "ssh"

      node.vm.provider :virtualbox do |vb|
        vb.customize ["modifyvm", :id, "--memory", 512]
        vb.customize ["modifyvm", :id, "--cpus", 1]
      end

      # Usuarios base + permisos
      node.vm.provision "shell", inline: <<-SHELL
        for user in mperalta lcofresi; do
          if ! id "$user" &>/dev/null; then
            useradd -m -s /bin/bash "$user"
            echo "$user:vagrant01" | chpasswd
          fi
        done
        usermod -aG sudo mperalta
      SHELL

      # Provisionamiento específico por servidor
      case machine[:hostname]
      when "Server1"
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update
          apt-get install -y nginx
          echo "<h1>Hello World from Server1</h1>" > /var/www/html/index.nginx-debian.html
          systemctl enable nginx
          systemctl start nginx
        SHELL
      when "Server2"
        node.vm.provision "shell", inline: <<-SHELL
          echo "mysql-server mysql-server/root_password password root" | debconf-set-selections
          echo "mysql-server mysql-server/root_password_again password root" | debconf-set-selections
          apt-get update
          apt-get install -y mysql-server

          mysql -uroot -proot -e "CREATE USER 'mperalta'@'localhost' IDENTIFIED BY 'mperalta';"
          mysql -uroot -proot -e "GRANT ALL PRIVILEGES ON *.* TO 'mperalta'@'localhost' WITH GRANT OPTION;"
          mysql -uroot -proot -e "FLUSH PRIVILEGES;"
          systemctl enable mysql
          systemctl start mysql
        SHELL
      when "Server3"
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update
          apt-get install -y samba
          mkdir -p /srv/myshared
          chown -R mperalta:mperalta /srv/myshared

          echo -ne "mperalta\nmperalta\n" | smbpasswd -a -s mperalta

          echo "[myshared]
  path = /srv/myshared
  browseable = yes
  read only = no
  guest ok = no
  valid users = mperalta" >> /etc/samba/smb.conf

          systemctl restart smbd
          systemctl enable smbd
        SHELL
      end
    end
  end
end
